# Gemini configuration template. Keep the actual key in your private .env.
# Use a Gemini key belonging to your chosen Google AI Studio project.
# Model access and free-tier quota must be checked for that project.
# Replace existing settings instead of appending duplicate variable names.
AI_MODE=online
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=replace_with_your_private_gemini_key
AI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=120
